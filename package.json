  },
  "type": "module",
  "files": [
    "lib",
    "README.md",
    "DESIGN.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/dsh-grok-goals.d.ts",
      "import": "./lib/dsh-grok-goals.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "entry": "./lib/client.js",
